# .env.example (Root)
# ---------------------------------------------------------------------------
# Sentinel Security — root-level environment for docker-compose.
#
# Copy this file to `.env` (at the project root) and adjust the values
# before running `docker compose up`.
# ---------------------------------------------------------------------------

# PostgreSQL credentials (used by the db service initialization)
POSTGRES_USER=sms_admin
POSTGRES_PASSWORD=ChangeMeDbPassword
POSTGRES_DB=sms_db

# Optional — set to "true" to expose PostgreSQL on localhost:5432 for
# local development with external tools (e.g. psql, DBeaver).  Leave
# "false" for production to keep the DB internal-only.
COMPOSE_EXPOSE_DB=false
