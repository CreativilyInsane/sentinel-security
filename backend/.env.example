# backend/.env.example
# ===== Database =====
DATABASE_URL=postgresql+asyncpg://sms_admin:CHANGE_ME@db:5432/sms_db

# ===== Redis =====
# Redis DB 0 is used by the existing auth token blacklist.  We use
# DB 1 for the Celery broker and DB 2 for the result backend to keep
# concerns cleanly separated.
REDIS_URL=redis://redis:6379/0

# ===== JWT =====
JWT_SECRET_KEY=CHANGE_ME_GENERATE_A_SECURE_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS =====
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# ===== Initial Admin Seed =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME
ADMIN_EMAIL=admin@example.com

# ===== Recon Module Settings =====
# Maximum number of hosts a single scan may probe (also enforces CIDR size).
RECON_MAX_HOSTS=256
# Maximum number of TCP ports per port-scan module run.
RECON_MAX_PORTS=100
# Per-operation network timeout in seconds.
RECON_TIMEOUT=10
# Maximum number of concurrent TCP connections during host/port scanning.
RECON_MAX_CONCURRENT_CONNECTIONS=50
# Maximum number of concurrent active scans per user (rate limit).
RECON_MAX_ACTIVE_SCANS=2
# Maximum HTTP response body size in bytes (5 MB default).
RECON_HTTP_MAX_RESPONSE_SIZE=5242880
# Maximum HTTP redirects the recon module will follow.
RECON_MAX_REDIRECTS=5
# Screenshot capture timeout in seconds.
RECON_SCREENSHOT_TIMEOUT=30
# Where to persist generated screenshots (UUID filenames, no user control).
# Mounted as a Docker named volume so files survive container restarts.
RECON_SCREENSHOT_STORAGE_PATH=/app/recon_storage/screenshots

# NOTE: RECON_ALLOWED_PRIVATE_NETWORKS has been REMOVED.
# Private-network scan access is now controlled per-user via the
# 'private_network_scan' module permission on the User Module Settings page.

# ===== Celery =====
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
