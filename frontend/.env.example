# frontend/.env.example
# ---------------------------------------------------------------------------
# Sentinel Security — frontend build-time configuration.
#
# Copy this file to `.env` (in the frontend/ directory) before building.
# Vite reads VITE_* variables at build time and inlines them into the
# bundle.  Inside Docker, the nginx reverse proxy routes /api/* to the
# backend, so the default relative URL works for both dev and prod.
# ---------------------------------------------------------------------------

# API base URL.  Use a relative path "/api/v1" so the frontend talks to
# the same origin that served it (works behind nginx reverse proxy in
# Docker and with `vite dev` in local development).
VITE_API_URL=/api/v1
